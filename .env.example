# Copy to .env.local and fill in your values.
# Register your app at https://developer.spotify.com/dashboard
# Add "beatmatch://" as a Redirect URI in your Spotify app settings.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Register at https://getsongbpm.com/api to get a free API key
EXPO_PUBLIC_GETSONGBPM_API_KEY=your_getsongbpm_api_key_here
